	step4 [label="Step 5: For each iteration of the inner FOR loop (C2), AFIELD1 value is multiplied with I.NAFIELD, divided by L_SUM_AFIELD1, and rounded to decimal precision defined in variable L_DECIMAL. This calculated value is then added to running total L_TOTAL_AMT and assigned to variable L_SLNO."]
	step5 [label="Step 6: After the inner loop completes, if the final L_TOTAL_AMT does not match I.NAFIELD, a NULL operation is performed."]
